# ==========================================================
# GCC Portal - Environment Variables Example
# Copy this file to .env.local and NEVER commit real values.
# ==========================================================

# ---- Cloudflare Workers API ----
# The public URL of the deployed API worker
NEXT_PUBLIC_API_URL=http://localhost:8787

# ---- Cloudflare D1 Database ----
# Bound in wrangler.toml - DO NOT put here for production
# DB_NAME=gcc-d1

# ---- Session Secret ----
# Strong random hex string (min 64 chars). Generate: openssl rand -hex 64
SESSION_SECRET=REPLACE_WITH_STRONG_SECRET

# ---- Cloudflare Turnstile ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA  # Test key (always passes)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA  # Test key (always passes)

# ---- Google Service Account ----
# Used by Cloudflare Workers backend to access Sheets and Drive
# IMPORTANT: Set these as Cloudflare Worker secrets (wrangler secret put)
# NEVER put real credentials here
GOOGLE_SERVICE_ACCOUNT_EMAIL=gcc-service@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE\n-----END RSA PRIVATE KEY-----"

# ---- Google Workspace Config ----
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_root_folder_id_here

# ---- App Config ----
NODE_ENV=development
APP_URL=http://localhost:3000

